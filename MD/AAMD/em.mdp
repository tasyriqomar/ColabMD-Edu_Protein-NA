; em.mdp - Steepest Descents Energy Minimization
integrator              = steep
emtol                   = 1000.0        ; Force tolerance (kJ/mol/nm)
emstep                  = 0.01          ; nm
nsteps                  = 50000

cutoff-scheme           = Verlet
nstlist                 = 1
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
pbc                     = xyz
