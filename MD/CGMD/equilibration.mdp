integrator               = md
dt                       = 0.01         ; Safe for your DNA BB2-BB3 bond (0.11 ps period)
nsteps                   = 500000       ; 5 ns equilibration
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1000
nstxout-compressed       = 1000
compressed-x-precision   = 100

cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005

coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

lincs-order              = 4
lincs-iter               = 2

tcoupl                   = v-rescale
tc-grps                  = system
tau-t                    = 1.0
ref-t                    = 300
gen-vel                  = yes
gen-temp                 = 300

Pcoupl                   = c-rescale
Pcoupltype               = isotropic
tau-p                    = 4.0
compressibility          = 3e-4         ; Martini CG water compressibility
ref-p                    = 1.0
